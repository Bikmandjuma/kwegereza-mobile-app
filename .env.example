# Same backend the web app uses -- see Kwegereza-BackEnd's own README.
# Point this at your real deployed API when building for distribution,
# not localhost (a phone can't resolve "localhost" to your dev machine).
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# The separate live-class service -- see Kwegereza-LiveClass's own README.
EXPO_PUBLIC_LIVE_API_URL=http://localhost:4001/api
